# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Data providers
FMP_API_KEY=
FINNHUB_API_KEY=
OPENFIGI_API_KEY=
TD_API_KEY=

# AI
ANTHROPIC_API_KEY=

# SEC (used as User-Agent in SEC EDGAR requests)
SEC_CONTACT_EMAIL=your@email.com
