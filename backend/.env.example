# PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Data providers
FMP_API_KEY=
FINNHUB_API_KEY=
OPENFIGI_API_KEY=
TD_API_KEY=

# AI
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# SEC (used as User-Agent in SEC EDGAR requests)
SEC_CONTACT_EMAIL=your@email.com

# Auth — same value as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in the frontend
CLERK_PUBLISHABLE_KEY=pk_test_...

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://investhub.tech,https://www.investhub.tech
